{
  "name": "aula-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "study:generate": "node --env-file-if-exists=.env.local scripts/generate-study.mts",
    "study:prepare": "node --env-file-if-exists=.env.local scripts/prepare-shared-study.mts",
    "content:sync": "node scripts/sync-materials.mts",
    "study:test": "node --test scripts/study/study.test.mts",
    "uploads:test": "node --test scripts/uploads/uploads.test.mts",
    "web-study:test": "node --test scripts/study/web-study.test.mts scripts/study/document.test.mts scripts/editor/shared-study.test.mts",
    "check": "npm run lint && npm run study:test && npm run uploads:test && npm run web-study:test && npm run learning-tools:test && npm run practice:test && npm run ui:test && npm run reader:test && npm run build",
    "learning-tools:test": "node --test scripts/learning-tools/learning-tools.test.mts",
    "practice:test": "node --test scripts/practice/practice.test.mts",
    "ui:test": "node --test scripts/ui/ui.test.mts",
    "predev": "node scripts/prepare-pdf-viewer.mjs",
    "prebuild": "node scripts/prepare-pdf-viewer.mjs",
    "reader:test": "node --test scripts/reader/reader.test.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
